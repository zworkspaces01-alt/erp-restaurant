# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser. Used for seeding / admin scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Local Postgres (Docker) used only for migration smoke tests: npm run db:test
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/postgres
