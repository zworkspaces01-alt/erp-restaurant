# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser. Used for seeding / admin scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Local Postgres (Docker) used only for migration smoke tests: npm run db:test
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/postgres

# Groq Vision AI OCR (Lấy API Key miễn phí tại https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key

# Telegram Daily Report Bot (Cài đặt qua UI hoặc trực tiếp qua .env)
# 1. Tạo bot qua @BotFather trên Telegram để lấy Bot Token
# 2. Lấy Chat ID cá nhân/nhóm qua @userinfobot
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789
# Tùy chọn: Secret key bảo vệ webhook/cron endpoint: /api/telegram/daily-report?secret=...
TELEGRAM_CRON_SECRET=

